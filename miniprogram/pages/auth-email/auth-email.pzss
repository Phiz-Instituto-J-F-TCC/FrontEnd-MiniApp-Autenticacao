.auth-email-screen {
  min-height: 100vh;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 72rpx;
  box-sizing: border-box;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
}

.auth-email-content {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.auth-email-title {
  display: block;
  color: #1d0db8;
  font-size: 40rpx;
  line-height: 48rpx;
  font-weight: 700;
  text-align: center;
}

.auth-email-subtitle {
  display: block;
  width: 540rpx;
  color: #8b8b8b;
  font-size: 24rpx;
  line-height: 32rpx;
  text-align: center;
  margin-top: 44rpx;
}

.auth-email-form {
  width: 380rpx;
  margin-top: 46rpx;
}

.auth-email-input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #d9d9d9;
  border-radius: 12rpx;
  background: #ffffff;
  padding: 0 20rpx;
  font-size: 24rpx;
  color: #606060;
  box-sizing: border-box;
  font-family: inherit;
}

.auth-email-input-error {
  border-color: #ff6b6b;
}

.auth-email-error {
  display: block;
  color: #ff6b6b;
  font-size: 20rpx;
  line-height: 28rpx;
  margin-top: 12rpx;
}

.auth-email-primary-button {
  width: 354rpx;
  height: 80rpx;
  margin: 46rpx auto 0;
  border-radius: 12rpx;
  background: #1d0db8;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 80rpx;
  border: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: inherit;
}

.auth-email-primary-button-with-error {
  margin-top: 24rpx;
}
