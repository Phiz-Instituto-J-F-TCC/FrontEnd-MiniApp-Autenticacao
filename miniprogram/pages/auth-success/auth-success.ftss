.auth-success-screen {
  min-height: 100vh;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 62rpx;
  box-sizing: border-box;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
}

.auth-success-content {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.auth-success-symbol {
  width: 144rpx;
  height: 144rpx;
  border-radius: 72rpx;
  background: #e6f8eb;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 50rpx;
}

.auth-success-check {
  position: relative;
  width: 54rpx;
  height: 54rpx;
  border-radius: 10rpx;
  background: #00b51a;
  display: flex;
  align-items: center;
  justify-content: center;
}

.auth-success-check-stroke {
  position: absolute;
  height: 6rpx;
  border-radius: 6rpx;
  background: #ffffff;
}

.auth-success-check-stroke-short {
  left: 11rpx;
  top: 29rpx;
  width: 16rpx;
  transform: rotate(45deg);
  transform-origin: left center;
}

.auth-success-check-stroke-long {
  left: 22rpx;
  top: 31rpx;
  width: 30rpx;
  transform: rotate(-45deg);
  transform-origin: left center;
}

.auth-success-title {
  display: block;
  color: #1d0db8;
  font-size: 32rpx;
  line-height: 42rpx;
  font-weight: 700;
}

.auth-success-subtitle {
  display: block;
  color: #8b8b8b;
  font-size: 24rpx;
  line-height: 32rpx;
  margin-top: 46rpx;
}

.auth-success-primary-button {
  width: 354rpx;
  height: 78rpx;
  margin: 44rpx auto 0;
  border-radius: 12rpx;
  background: #1d0db8;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 78rpx;
  border: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: inherit;
}
